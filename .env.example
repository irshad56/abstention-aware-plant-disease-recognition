# Environment Configuration Example
# Copy this file to .env and configure as needed.

# Model Artifact Directory Override (Optional)
# PLANT_MODEL_ROOT=c:/Users/irfan/Downloads/irshad bin/Mini Project Documents

# Groq API Configuration (Optional - deterministic fallback is used if omitted)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Device Selection (auto, cpu, cuda)
# PLANT_DEVICE=auto

# Evidence Retrieval Network Access (true / false)
# ENABLE_LIVE_SEARCH=false
