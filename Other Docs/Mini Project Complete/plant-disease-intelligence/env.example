# Copy this file to ".env" in the project root and fill in values.
# Never commit ".env" (it is already in .gitignore).

# --- Optional: LLM explanations via Groq ---
# The app works without these; only the written explanation is affected.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: path overrides (leave blank to use configs/config.yaml) ---
# PD_ARTIFACT_ROOT=
# PD_DATASET_ROOT=
# PD_MANIFEST_PATH=
# PD_HF_CACHE=
