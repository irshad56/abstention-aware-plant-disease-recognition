# Virtual Environment
.venv/
venv/
ENV/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
outputs/*.log

# Sensitive Information
.env
*.pem
*.key

# Model weights & large archives (user supplies locally or via GitHub Release v2.0.0)
artifacts/models/**/*.pth
artifacts/models/**/*.pt
artifacts/models/**/*.safetensors
authoritative_release/**/*.pt
authoritative_release/**/*.pth
authoritative_plant_disease_models.zip
*.zip
*.pth
*.pt
!authoritative_release/**/*.joblib

# Streamlit runtime state (allow .streamlit config folder)
.streamlit/*.log

# Video & media recordings
*.mp4
*.mov
*.avi
*.mkv

# OS artifacts
.DS_Store
Thumbs.db

# Evaluation runs
outputs/evaluations/*
!outputs/evaluations/.gitkeep
